# 必填：至少 32 位随机串，JWT 签名密钥（会话依赖它，务必固定且保密）
# 留空也能跑：容器会自动在 /app/data/jwt_secret 生成并持久化
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# 对外端口（宿主机）
NW_PORT=3000

# 时区
TZ=Asia/Shanghai

# 可选：设为 1 隐藏 Web Vault（仅保留 API 给 Bitwarden 客户端）
HIDE_WEB_VAULT=

# 可选：Watchtower 通知方式（如 gotify / shoutrrr 格式），留空则不通知
WATCHTOWER_NOTIFICATIONS=
